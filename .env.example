# ==============================================================================
# COOLIFY PRODUCTION ENVIRONMENT VARIABLES (Stock UMKM)
# Salin (copy) seluruh isi file ini dan paste di tab "Environment Variables" Coolify
# ==============================================================================

APP_NAME="Stock UMKM"
APP_ENV=production
APP_KEY=base64:a2HRyq8+zBlm+uM9KRmqw3j5LoaN3++Gd2l0ezxBZP0=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Maintenance
APP_MAINTENANCE_DRIVER=file

# Keamanan password hash
BCRYPT_ROUNDS=12

# Logging (stderr agar logs aplikasi langsung terbaca di tab Logs Coolify)
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==============================================================================
# DATABASE CONFIGURATION (MySQL)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=100.106.63.90
DB_PORT=3306
DB_DATABASE=stock_umkm
DB_USERNAME=root
DB_PASSWORD=adminroot12345

# ==============================================================================
# SESSION, CACHE & QUEUE (Disimpan di Database)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# MAIL SETTINGS (Default log, sesuaikan jika menggunakan SMTP / Resend / Mailgun)
# ==============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@stockumkm.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# FRONTEND / VITE
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
